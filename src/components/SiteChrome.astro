---
import type { Locale, UiStrings } from '../types/resume';
import { getPdfPath } from '../lib/resume';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import Download from './icons/Download.astro';

interface Props {
  locale: Locale;
  ui: UiStrings;
}

const { locale, ui } = Astro.props;
const pdfPath = getPdfPath(locale);

const navItems = [
  { href: '#experience', label: ui.navExperience },
  { href: '#skills', label: ui.navSkills },
  { href: '#education', label: ui.navEducation },
  { href: '#interests', label: ui.navInterests },
];
---

<div class="no-print sticky top-0 z-50 border-b border-muted bg-surface/90 backdrop-blur-md">
  <div
    class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-2 gap-y-2 px-4 py-3 sm:flex-nowrap sm:gap-3 sm:px-6"
  >
    <nav
      class="flex min-w-0 flex-1 flex-wrap gap-x-3 gap-y-1 text-sm font-medium sm:flex-nowrap sm:gap-x-4"
      aria-label="Section navigation"
    >
      {
        navItems.map((item) => (
          <a href={item.href} class="shrink-0 text-muted transition hover:text-accent">
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex shrink-0 flex-nowrap items-center gap-1.5 sm:gap-2">
      <a
        href={pdfPath}
        download={`resume-${locale}.pdf`}
        class="btn-outline btn-with-icon max-md:gap-0 max-md:px-2.5"
        aria-label={ui.downloadPdfAria}
      >
        <Download class="icon text-muted" size={14} />
        <span class="hidden md:inline">{ui.downloadPdf}</span>
      </a>
      <LanguageSwitcher locale={locale} />
      <ThemeToggle ui={ui} />
    </div>
  </div>
</div>
