---
import type { Resume, UiStrings } from '../types/resume';

interface Props {
  resume: Resume;
  ui: UiStrings;
}

const { resume, ui } = Astro.props;
---

<section id="interests" class="no-print mb-14 scroll-mt-24">
  <h2 class="section-heading">{ui.navInterests}</h2>
  <ul class="flex flex-wrap gap-2">
    {
      resume.interests.map((interest) => (
        <li class="skill-tag">{interest.name}</li>
      ))
    }
  </ul>
</section>
