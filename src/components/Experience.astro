---
import type { Locale, Resume, UiStrings } from '../types/resume';
import { formatDateRange } from '../lib/resume';

interface Props {
  resume: Resume;
  ui: UiStrings;
  locale: Locale;
}

const { resume, ui, locale } = Astro.props;
---

<section id="experience" class="mb-14 scroll-mt-24">
  <h2 class="section-heading">{ui.navExperience}</h2>
  <ol class="space-y-10">
    {
      resume.work.map((job) => (
        <li class="print-break-inside-avoid border-l-2 border-muted pl-5 transition hover:border-accent">
          <article>
            <h3 class="text-lg font-semibold text-primary">{job.name}</h3>
            <p class="mt-1 text-sm font-medium text-muted">
              {job.position}
              <span class="mx-2 opacity-40">·</span>
              <time datetime={job.startDate} class="text-primary">
                {formatDateRange(job.startDate, job.endDate, ui.present, locale)}
              </time>
            </p>
            {job.summary && (
              <p class="mt-3 text-sm leading-relaxed text-muted">{job.summary}</p>
            )}
            {job.highlights && job.highlights.length > 0 && (
              <ul class="achievement-list mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted">
                {job.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {job.technologies && job.technologies.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2" aria-label={ui.technologies}>
                {job.technologies.map((tool) => (
                  <li class="tool-tag">{tool}</li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))
    }
  </ol>
</section>
