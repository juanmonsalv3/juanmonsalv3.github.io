---
import type { Resume, UiStrings } from '../types/resume';

interface Props {
  resume: Resume;
  ui: UiStrings;
}

const { resume, ui } = Astro.props;
---

<section id="languages" class="mb-14 scroll-mt-24">
  <h2 class="section-heading">{ui.navLanguages}</h2>
  <ul class="space-y-3">
    {
      resume.languages.map((entry) => (
        <li class="print-break-inside-avoid flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <span class="font-medium text-primary">{entry.language}</span>
          <span class="text-sm text-muted">— {entry.fluency}</span>
        </li>
      ))
    }
  </ul>
</section>
